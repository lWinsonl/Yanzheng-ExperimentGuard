# 研证 - 服务端配置模板
# 复制为 .env 并填入实际值。密钥仅存在于服务端,绝不下发前端。

# ---- 大模型配置(可选) ----
# 不配置时智能体自动降级到启发式规则模式,所有功能仍可用。
# 支持任何 OpenAI 兼容接口:智谱 / DeepSeek / OpenAI / 本地 vLLM 等。
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash

# 示例 - DeepSeek:
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 示例 - 本地 vLLM:
# LLM_API_KEY=dummy
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen2.5-7B-Instruct

# ---- 存储目录 ----
DATA_DIR=./data
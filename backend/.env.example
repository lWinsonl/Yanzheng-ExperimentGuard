# 研证 - 服务端配置模板
# 复制为 .env 并填入实际值。密钥仅存在于服务端,绝不下发前端。

# ---- 大模型配置(可选) ----
# 不配置时智能体自动降级到启发式规则模式,所有功能仍可用。
# 支持任何 OpenAI 兼容接口:智谱 / DeepSeek / OpenAI / 本地 vLLM 等。
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.7-flash
# 备用模型仅在用户点击重试时调用，不自动切换。留空时，智谱 4.7-Flash 可手动退回旧 glm-4-flash。
LLM_FALLBACK_MODEL=

# 等待模型响应的超时参数（秒）；复杂复核使用单独预算。
LLM_TIMEOUT_SECONDS=60
LLM_REVIEW_TIMEOUT_SECONDS=120
# 以下思考开关仅用于智谱标准接口的 glm-4.7-flash。
# 普通提取关闭额外思考；复杂复核保留思考并增加输出预算。
LLM_THINKING=disabled
LLM_REVIEW_THINKING=enabled
LLM_REVIEW_MAX_TOKENS=8192

# 示例 - DeepSeek:
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 示例 - 本地 vLLM:
# LLM_API_KEY=dummy
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen2.5-7B-Instruct

# ---- 存储目录 ----
DATA_DIR=./data

# ---- 前端静态资源目录(生产部署用) ----
# Docker 部署时前端构建产物(dist)会被复制到此目录,后端自动托管。
# 本地开发时此目录不存在,后端自动跳过挂载,前端走 Vite 开发服务器。
STATIC_DIR=./static
